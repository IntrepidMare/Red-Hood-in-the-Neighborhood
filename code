}

.filters .expander,
.filters .expanded .expander {
  filter: brightness(0) saturate(100%) invert(89%) sepia(3%) saturate(179%) hue-rotate(299deg) brightness(104%) contrast(95%);
}

.filters input:checked + .indicator + span,
.filters input:checked + .indicator + span a {
  background: var(--color1);
  color: #EAE7E8;
  border-radius: 4px;
  padding: 1px 4px;
  font-weight: 700;
}

/*==ZONE: TAGS, TAGSETS, and TAG WRANGLING */ 


/* USERSTUFF */

.userstuff p,
.userstuff details {
  margin: 1.286em auto;
  text-indent: 0.5in;
  text-align: justify;
  padding: 0 2em;
}

.notice,
.event .userstuff,
.comment_notice,
.kudos_notice,
ul.notes,
.caution,
.error,
.comment_error,
.kudos_error,
.alert.flash {
  box-shadow: 3px 3px 5px var(--color5);
  margin: 0.643em auto;
  padding: 0.25em 0.375em;
  clear: right;
  border-radius: 0.25em;
  word-wrap: break-word;
  border: 0;
}

/* ADMIN ANNOUNCEMENT BANNERS */ 

.event .userstuff {
  background: #700;
  border-color: #600;
  color: #fff;
}


/* thermometer JavaScript widget for fundraising drives
progress indicator colors are set in applicationicon js */
.announcement .thermometer .track {
  box-shadow: 3px 3px 5px var(--font);
