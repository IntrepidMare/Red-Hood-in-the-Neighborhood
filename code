  background-size: 200px 820px !important;
}

                /* MAIN PAGE */

    /* HEADER BANNER */

#header {
  background-color: var(--bg2);
  background-image: url("https://i.ibb.co/5pkJ4Jt/Under-The-Red-Hood-Full-10.png"); 
  background-repeat: no-repeat;
  background-position: center center;
  background-size: cover;
}

#header .heading {
  height: 14.375em;
}

/* FAVORITES, NEWS, SOCIAL, ETC */
.splash {
  margin: auto;
  max-width: 78em;
}

.splash .module h3 {
  border-bottom: 1px solid #c8c8c8;
  font-size: 1.714em;
}

.splash span.link {
  float: right;
}

.splash .link a {
  font-size: 0.583em;
}

.splash .browse,
.splash div.news {
  width: 36%;
}

.splash .intro,
.splash .social {
  float: right;
  width: 60%;
}

.splash .browse ul,
.splash .browse li {
  float: left;
  width: 100%;
  box-sizing: border-box;
}

.splash .browse li a,
.splash .favorite a {
  border-bottom: none;
  display: block;
}

.splash .browse li {
  margin: 0.375em 0;
  padding: 0.375em 0;
  width: 50%;
}

.splash .browse li a:before {
  content: "\00BB";
  padding: 0 0.25em 0 0;
}

.splash .browse li:nth-of-type(1),
.splash .browse li:nth-of-type(2) {
  margin-top: 0;
}

.splash .browse li:nth-of-type(odd) {
  padding-right: 0.375em;
}

.splash .intro {
  padding: 1em 0 2em;
}

.splash .intro h2 {
  font-size: 2em;
  line-height: 1.375;
}

.splash .intro .stats,
.splash .parent {
  text-align: center;
}

.splash .count {
  font-weight: 700;
}

.splash .module div.account {
  background: #eaeaea;
  border: 1px solid #ccc;
  border-radius: 0.5em;
  box-sizing: border-box;
}

.splash .account .heading {
  margin: 1em;
}

.splash .account p {
  margin-left: 1em;
  margin-right: 1em;
}

.splash .account ul {
  margin-left: 4em;
  margin-right: 1em;
}

.splash .account li {
  list-style-type: disc;
}

.splash .account .actions {
  float: none;
  font-size: 1.143em;
}

.splash .favorite li {
  margin: 0;
}

.splash .favorite a {
  padding: 0.25em 0.375em;
}

.splash .news li {
  border-bottom: 1px solid #eee;
}

.splash .news li:last-of-type {
  border-bottom: none;
}

.splash .news .meta {
  font-weight: normal;
  font-size: 0.857em;
  font-family: 'Monaco', 'Consolas', Courier, monospace;
}

.splash .news blockquote {
  float: left;
}

.splash .jump {
  text-align: right;
}

.splash .placeholder {
  font-style: italic;
}

    /* marked for later */

.splash .blurb blockquote {
  margin: 0.643em auto;
  text-indent: 1.5em;
}

    /* unread messages */

.splash .comment .userstuff {
  margin: 1em;
}

    /* social */

.splash .social ul {
  text-align: center;
}

.splash .social li {
  display: inline-block;
}

    /* logged-in */

.logged-in .splash > .module {
  float: left;
  margin: 0 1% 1.571em 1%;
  width: 48%;
}

.logged-in .splash > div:nth-of-type(odd) {
  clear: left;
}

    /* misc */

.splash .module .module,
.splash .dynamic,
.splash .news blockquote {
  margin: 0;
  width: 100%;
}

blockquote.userstuff p,
p.note {
  text-indent: 1.5em;
  text-align: justify;
}

/* --- NORMAL ELEMENTS --- */

a:visited {
  text-decoration: none;
  border-bottom: 1px dashed;
}

a:active,
a:focus,
button:focus {
  outline: 1px dotted;
}

header h1.heading a::before {
  margin-left: 0.35em;
  content: "HOLY ARCHIVE, BATMAN!";
  text-shadow: -2px 0 var(--color2), 0 2px var(--color2), 2px 0 var(--color2), 0 -2px var(--color2); 
}

#header h1.heading span {
  display: none;
}

.home .primary {
  margin: 0 0 0.643em;
  min-height: 100px;
}

                /* HEADER */

    /* logo and title */
    
#header .logo {
  float: left;
  height: 42px;
  background: url("https://i.ibb.co/CK813g3r/red-hood-logo-small.png");
  width: 0 !important;
  height: 0 !important;
  padding: 40px 55px 0px 45px;
  background-repeat: no-repeat;
}

#header .menu,
#small_login {
  display: none;
  padding: 0.25em 0;
  position: absolute;
  width: 20em;
  z-index: 55;
  box-shadow: 1px 1px 3px -1px #444;
}

    /*ACTION: dropdown*/

#header .dropdown .menu a {
  background: transparent;
  display: block;
  padding: 0.75em 0.5em 0.5em;
}

    /* login and greeting */

#greeting .dropdown .menu a {
  border-radius: 5px;
}

/* primary (Header) navigation */

#header .primary {
  padding: 0 0;
  width: 100%;
  box-shadow: inset 0 -6px 10px rgba(0, 0, 0, 0.35),
    1px 1px 3px -1px rgba(0, 0, 0, 0.25),
    inset 0 -1px 0 rgba(0, 0, 0, 0.85);
}

#header .primary > li:first-of-type {
  margin-left: 2em;
}

#header .primary a {
  padding: 0.429em 0.75em;
}

#header .primary .menu a {
  color: #111;
  padding: 0.75em 0.5em 0.5em;
}

    /* search */

#header .search {
  float: right;
  color: var(--color1);
  margin-right: 0.25em;
}

#header #search input:focus {
  outline: 1px dotted;
}

#header #search .text,
#header #search .button {
  border: 2px solid var(--bg);
}

#header #search .text {
  margin: 0.2857em 0.429em;
}

input#general_search_autocomplete.text {
  color: var(--color4);
}

#header #search .button {
  margin: 0;
}

        /*CONTEXT: collections*/

#header h2 {
  border-top: 1px solid;
  clear: both;
  color: var(--color4);
  display: block;
  font-size: 1.714em;
  line-height: 1.5;
  margin: 0;
  padding: 0 0.375em;
  text-shadow: none;
}

            /* DASHBOARD (Sidebar) */

#dashboard {
  padding: 0.5em;
  margin-left: 0;
}

#dashboard a,
#dashboard span {
  white-space: normal;
  vertical-align: middle;
  height: auto;
  margin: 0;
  border: none;
  word-wrap: break-word;
  font-size: 90%;
}

#dashboard ul {
  float: none;
  display: block;
  padding: 0.286em 0;
  text-align: right;
  border-top: 0 solid var(--color6);
  position: relative;
}

#dashboard.own {
  background: transparent;
  border-top: 0 solid var(--color6);
  border-bottom: 0 solid var(--color6);
  opacity: 1.0;
}

#main.dashboard {
  padding-left: 2em;
}

        /* FOOTER */

#footer {
  border-top: 2px solid;
  float: left;
  font-size: 0.75em;
  position: relative;
  padding: 0;
  width: 100%;
}

#footer a {
  display: inline;
  border-bottom: 1px dotted;
  line-height: 1.5;
  white-space: normal;
}

#footer .heading {
  display: block;
  text-transform: uppercase;
}

            /* INTERACTIONS */

fieldset,
form dl,
fieldset dl dl,
fieldset fieldset fieldset,
fieldset fieldset dl dl,
dd.hideme,
form blockquote.userstuff {
  display: block;
  margin: 0.643em;
  padding: 0.643em;
  box-shadow: inset 1px 0 5px var(--bg2);
  border: 0;
}

fieldset dd dl,
form .meta dd,
fieldset dl fieldset dl,
dd fieldset {
  margin: 0 0.643em;
}

legend,
input[type="hidden"] {
  height: 0;
  width: 0;
  font-size: 0;
  opacity: 0;
  padding: 0;
  margin: 0;
}

label {
  margin-right: 0.375em;
}

input,
textarea {
  font-size: 100%;
  width: 100%;
  border-radius: 5px;
  box-shadow: inset 0 1px 2px var(--bg2);
  height: 20px;
}

textarea {
  min-height: 12em;
}

textarea.large {
  height: 36em;
}

input[type="radio"] + label,
input[type="checkbox"] + label {
  padding-left: 1em;
}

select {
  vertical-align: text-top;
  width: 100%;
  min-width: 10.5em;
  border-radius: 5px;
}

.datecolor2e select {
  width: 32.5%;
}

input[type="radio"],
input[type="checkbox"],
input[type="file"],
input.number,
p input,
p select,
.heading select,
li select {
  width: auto;
  margin-right: 0.375em;
}

input.number {
  width: 4em;
}

option,
.actions option,
form code {
  display: block;
}

option:checked {
  background: var(--color6);
}

form p {
  clear: right;
  margin: auto;
  padding: 0.643em;
}

form dd ul {
  text-align: justify;
}

form .notice {
  box-shadow: none;
}

    /* LIVE VALIDATION */

.LV_invalid {
  border: 1px solid #04030F;
  padding: 0.25em 0.375em;
  box-shadow: 1px 1px 2px;
  border-radius: 0.25em;
}

.LV_invalid_field,
input.LV_invalid_field:hover,
input.LV_invalid_field:active,
textarea.LV_invalid_field:hover,
textarea.LV_invalid_field:active {
  border: 1px solid var(--bg);
}

.LV_invalid:before {
